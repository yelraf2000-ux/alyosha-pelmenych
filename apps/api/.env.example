# Copy to .env and adjust. Never commit .env.

# Dev database started by `npm run db:start` (private cluster in .devdb/, no password).
DATABASE_URL=postgres://postgres@localhost:54329/alyosha

# Separate database for `npm test`. The tests empty every table in it.
DATABASE_URL_TEST=postgres://postgres@localhost:54329/alyosha_test

PORT=3000

# Origin of the storefront, used for CORS.
PUBLIC_BASE_URL=http://localhost:5173

# Telegram notifications to the owner. While these are empty, messages are printed to the API log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 1 only when the API sits behind nginx/Caddy (Phase 3), so client IPs come from X-Forwarded-For.
TRUST_PROXY=0

# Admin panel (/admin). These two values are a DEVELOPMENT login only: the password behind this
# hash is the DEV_ADMIN_PASSWORD constant in src/auth.ts. The API refuses to start with them
# when NODE_ENV=production. Set a real password with: npm run admin:password
ADMIN_PASSWORD_HASH=$2b$10$8Q.xEK4R4sNAw/sFF2TDI.NXNxr0fT7Nz.Y9MFYkzLInDXZLlyiyO
SESSION_SECRET=dev-only-session-secret-replace-before-deploy

# Folder for uploaded product photos (relative to apps/api).
UPLOADS_DIR=uploads

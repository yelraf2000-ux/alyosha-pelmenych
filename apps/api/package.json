{
  "name": "@alyosha/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "admin:password": "tsx src/cli/set-admin-password.ts",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@alyosha/shared": "^0.0.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.3.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}

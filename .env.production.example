# Settings for the production server.
# Copy this file to `.env` in the same folder as docker-compose.yml and fill it in.
# `.env` holds secrets: it is git-ignored and must never be committed or sent in a chat.

# The site's domain, without https:// and without www. Its DNS A record must point at this server.
DOMAIN=pelmeni.am

# Database password. Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs the admin session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Admin panel password, as a hash. Create the line with (README, "Admin password"):
#   docker compose run --rm --no-deps api node apps/api/dist/set-admin-password.js --print
ADMIN_PASSWORD_HASH=

# Telegram notifications for new orders and "notify me" requests (README, "Telegram bot").
# While these are empty the shop works, and messages are only written to the API log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
